	partition fact_eiendom = m
		mode: import
		source =
				let
				    Kilde = fnLesCsv("fact_eiendom.csv"),
				    Kolonner = Table.SelectColumns(Kilde, {"region_id", "aar", "funksjon_kode", "netto_1000kr", "korr_brutto_1000kr", "brutto_1000kr", "netto_per_innbygger", "korr_brutto_per_kvm", "innbyggere", "kilde"}),
				    Typer = Table.TransformColumnTypes(Kolonner, {{"region_id", type text}, {"aar", Int64.Type}, {"funksjon_kode", type text}, {"netto_1000kr", type number}, {"korr_brutto_1000kr", type number}, {"brutto_1000kr", type number}, {"netto_per_innbygger", type number}, {"korr_brutto_per_kvm", type number}, {"innbyggere", type number}, {"kilde", type text}}, "en-US")
