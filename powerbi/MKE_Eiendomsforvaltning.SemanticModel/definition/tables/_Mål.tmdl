	/// Turkis for Moss, rosa for kommuner som bruker mer per innbygger enn Moss, indigo for de som bruker mindre.
	measure 'Farge kart' =
			VAR _V = [Eiendomsforvaltning per innbygger]
			VAR _Moss = CALCULATE ( [Eiendomsforvaltning per innbygger], REMOVEFILTERS ( dim_region ), dim_region[region_id] = "3103" )
			RETURN
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( dim_region[region_id] ) = "3103", "#2DD4BF",
			        _V > _Moss, "#FF6B8B",
			        "#7C83FF"
			    )
		isHidden
		displayFolder: Visning
		lineageTag: 35eaaab4-1675-5c70-b565-cb8247907cd8

	measure 'Data til og med' = "KOSTRA " & CALCULATE ( MAX ( fact_eiendom[aar] ), REMOVEFILTERS () )
		isHidden
		displayFolder: Tekst
		lineageTag: 50186a31-d414-5746-8593-d2a9fa1f921e

	/// Sju funksjoner minus SSBs FGK6a, tusen kroner. Skal være 0.
	measure 'Kontroll aggregat mot deler' =
			VAR _Deler = CALCULATE ( SUM ( fact_eiendom[korr_brutto_1000kr] ), dim_funksjon[Er aggregat] = FALSE () )
			VAR _Fgk6a = CALCULATE ( SUM ( fact_eiendom[korr_brutto_1000kr] ), dim_funksjon[funksjon_kode] = "FGK6a" )
			RETURN
			    _Deler - _Fgk6a
		formatString: #,0
		displayFolder: Kontroll
		lineageTag: e08c5932-cac0-5b0c-8e05-39e185951033

	/// Sum over artene (tabell 12367) minus korrigerte brutto (tabell 12559), tusen kroner. 0 for alle regioner unntatt landet.
	measure 'Kontroll art mot hovedtabell' =
			VAR _Art = SUM ( fact_art[belop_1000kr] )
			VAR _Hoved = CALCULATE ( SUM ( fact_eiendom[korr_brutto_1000kr] ), dim_funksjon[Er aggregat] = FALSE () )
			RETURN
			    _Art - _Hoved
		formatString: #,0
		displayFolder: Kontroll
		lineageTag: feb2d123-560c-54bb-9965-a81ad6c08480

